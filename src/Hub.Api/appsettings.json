{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "Hub": {
    "IdentityStore": {
      "Provider": "InMemory"
    },
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=hub-state.db",
      "CrosswalkConnectionString": "Data Source=hub-crosswalk.db"
    },
    "Crosswalk": {
      "RunAtStartup": true,
      "AcceptThreshold": 0.9,
      "MinMargin": 0.1,
      "RegionBonus": 0.05,
      "Countries": {
        "XA": [ "Xaria", "XAL", "900" ],
        "XB": [ "Xbaland", "XBL", "901" ]
      },
      "CanonicalCities": [
        { "id": "city-aldermoor", "name": "Aldermoor", "country": "XA", "region": "Northmark" },
        { "id": "city-brightwater", "name": "Brightwater", "country": "XA", "region": "Eastshore" },
        { "id": "city-cedarfall", "name": "Cedarfall", "country": "XA", "region": "Highland" },
        { "id": "city-saint-orrin", "name": "Saint Orrin", "country": "XA", "region": "Northmark" },
        { "id": "city-brightwater-bay", "name": "Brightwater Bay", "country": "XA", "region": "Eastshore" },
        { "id": "city-aldermoor-heights", "name": "Aldermoor Heights", "country": "XA", "region": "Northmark" },
        { "id": "city-aldermoor-xb", "name": "Aldermoor", "country": "XB", "region": "Westvale" }
      ]
    },
    "SamePlace": {
      "MaxDistanceMeters": 300,
      "MinNameSimilarity": 0.5,
      "NameOnlyMinSimilarity": 0.85
    },
    "Pricing": {
      "FxRates": { "EUR/USD": 1.08 }
    },
    "Quotes": {
      "Lifetime": "00:10:00"
    },
    "Bookings": {
      "PayLaterMinimumLead": "3.00:00:00",
      "PayLaterCancelBuffer": "1.00:00:00",
      "MaxBookAttempts": 2,
      "SyncInterval": "00:00:30",
      "PayLaterSweepInterval": "00:01:00"
    },
    "Demo": {
      "SeedIdentities": true
    },
    "Search": {
      "GlobalDeadline": "00:00:15",
      "UpdateChannelCapacity": 256,
      "MaxOffersPerHotel": 25
    },
    "Sse": {
      "HeartbeatInterval": "00:00:15"
    },
    "Streaming": {
      "ReplayBufferSize": 512,
      "ReplayRetention": "00:05:00",
      "MaxRetainedRuns": 128,
      "DisconnectGrace": "00:00:30"
    },
    "Tenancy": {
      "Tenants": {
        "tenant-demo": {
          "EnabledSuppliers": [ "supplier-a", "supplier-b", "supplier-c" ],
          "MarkupPercent": 10
        },
        "tenant-limited": {
          "EnabledSuppliers": [ "supplier-a" ],
          "MarkupPercent": 0
        }
      }
    },
    "Resilience": {
      "Defaults": {
        "MaxAttempts": 3,
        "RetryBaseDelay": "00:00:00.200",
        "CircuitFailureRatio": 0.5,
        "CircuitMinimumThroughput": 10,
        "CircuitSamplingDuration": "00:00:30",
        "CircuitBreakDuration": "00:00:30",
        "QueueLimit": 20
      },
      "Suppliers": {
        "supplier-b": {
          "Timeout": "00:00:06"
        }
      }
    },
    "Mapping": {
      "MaxRecordsPerCanonicalId": 50,
      "AliasMaxHops": 5,
      "AliasHitTtl": "00:10:00",
      "AliasMissTtl": "00:02:00"
    },
    "FakeSuppliers": {
      "Seed": 42,
      "HotelsPerCity": 24,
      "SupplierA": { "Coverage": 90, "PageSize": 8 },
      "SupplierB": { "Coverage": 80, "PollInterval": "00:00:00.025", "MaxWait": "00:00:05", "BatchSize": 6, "BatchDelay": "00:00:00.015" },
      "SupplierC": { "Coverage": 70, "SessionTtl": "00:01:00", "RoomsBatchSize": 6 }
    }
  },
  "Auth": {
    "Keys": []
  }
}
